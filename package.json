{
  "name": "drawy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "tsx apps/server/main.ts",
    "build": "vite build && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "start": "tsx apps/server/main.ts"
  },
  "dependencies": {
    "@drawy/materials": "workspace:*",
    "@drawy/ui": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "lucide-react": "0.468.0",
    "mermaid": "^11.12.0",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "^25.0.0",
    "vitest": "3.2.7",
    "prettier": "^3.6.0"
  }
}
