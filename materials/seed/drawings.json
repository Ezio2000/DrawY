    "category": "drawing/connector",
    "about": "An arrow whose head is sized to its line: straight or curved (bend), dashed, open or filled head, double-ended, an optional label beside the middle, and flow (animated dashes moving along it) for movement of blood, water, data or energy. As a link it runs between the anchors; in a module between data.from and data.to.",
    "tags": ["arrow", "link", "flow", "connector", "direction"],
    "style": null,
    "origin": { "kind": "curated", "createdAt": 1793404800000 },
    "use": "link",
    "size": { "width": 200, "height": 60 },
    "params": {
      "bend": { "type": "number", "default": 0, "description": "curvature as a fraction of length; positive bends left of the direction of travel" },
      "head": { "type": "string", "default": "filled", "description": "filled | open | none" },
      "both": { "type": "boolean", "default": false, "description": "a head at both ends" },
      "dashed": { "type": "boolean", "default": false, "description": "dashed line" },
      "flow": { "type": "boolean", "default": false, "description": "dashes move along the arrow" },
      "speed": { "type": "number", "default": 1.2, "description": "seconds per flow cycle" },
      "label": { "type": "string", "description": "a few words beside the middle" },
      "labelSide": { "type": "string", "default": "above", "description": "above | below" },
      "color": { "type": "color", "description": "defaults to the ink token" },
      "width": { "type": "number", "description": "line width; defaults to the stroke token" },
      "gap": { "type": "number", "default": 6, "description": "space left before the anchors" },
      "from": { "type": "object", "description": "in a module: start point {x,y} 0..1" },
      "to": { "type": "object", "description": "in a module: end point {x,y} 0..1" }
    }
  },
